---
import TargetCard from './TargetCard.astro';
import type { Experience } from '../data/site';

interface Props {
  job: Experience;
}
const { job } = Astro.props;
---

<TargetCard as="article" class="job">
  <div class="job__when mono">
    <span class="job__dates">{job.dates}</span>
    <span>{job.place}</span>
  </div>
  <div class="job__what">
    <h3 class="job__role">{job.role}</h3>
    <p class="job__org">{job.org}</p>
    <ul class="job__points">
      {job.points.map((p) => <li>{p}</li>)}
    </ul>
  </div>
</TargetCard>

<style>
  .job {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 8px 40px;
    padding: 26px 28px;
  }
  .job__when {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 13px;
    color: var(--text-3);
  }
  .job__dates {
    white-space: nowrap;
  }
  .job__role {
    font-size: 18px;
    line-height: 1.4;
    font-weight: 600;
  }
  .job__org {
    color: var(--text-2);
    margin-top: 2px;
  }
  .job__points {
    margin: 12px 0 0;
    padding-left: 18px;
    color: var(--text-2);
    font-size: 15px;
  }
  .job__points li + li {
    margin-top: 4px;
  }
  @media (max-width: 760px) {
    .job {
      grid-template-columns: 1fr;
      padding: 22px 20px;
    }
  }
</style>
