---
import SectionHeader from './SectionHeader.astro';
import { profile, sections, meta } from '../data/site';
import { publicAssetExists } from '../lib/assets';

const s = sections.find((x) => x.id === 'about')!;
const hasPhoto = publicAssetExists(profile.photo);
const showTodo = !profile.about && import.meta.env.DEV;
---

<section id={s.id} data-sec={s.sec} class="section about reveal" aria-labelledby={`${s.id}-title`}>
  <div class="about__text">
    <SectionHeader {...s} />
    {profile.about && <p class="about__body">{profile.about}</p>}
    {showTodo && <p class="about__body about__todo">{meta.aboutTodo}</p>}
    <div class="about__meta">
      <span>{profile.education}</span>
      <span>{profile.award}</span>
    </div>
  </div>
  <div class="about__photo">
    {
      hasPhoto ? (
        <img src={profile.photo} alt={meta.portraitAlt} width="560" height="700" loading="lazy" decoding="async" />
      ) : (
        <div class="about__placeholder" role="img" aria-label={meta.portraitAlt}>
          {meta.photoPlaceholder}
        </div>
      )
    }
    <span class="br br--tl" aria-hidden="true"></span>
    <span class="br br--tr" aria-hidden="true"></span>
    <span class="br br--bl" aria-hidden="true"></span>
    <span class="br br--br" aria-hidden="true"></span>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 280px;
    align-items: center;
    gap: 40px 64px;
  }
  .about :global(.sec-h2) {
    margin-bottom: 16px;
  }
  .about__body {
    color: var(--text-2);
    max-width: 62ch;
  }
  .about__todo {
    border: 1px dashed var(--line-strong);
    padding: 12px 14px;
    border-radius: var(--radius-chip);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .about__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 20px;
    font-size: 14px;
    color: var(--text-3);
  }
  .about__photo {
    position: relative;
    width: 280px;
    aspect-ratio: 4 / 5;
  }
  .about__photo img,
  .about__placeholder {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-chip);
  }
  .about__photo img {
    object-fit: cover;
  }
  .about__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-2);
    border: 1px solid var(--line-card);
    color: var(--text-3);
    font-size: 14px;
  }
  .br {
    position: absolute;
    width: 24px;
    height: 24px;
    border: 0 solid var(--accent);
  }
  .br--tl {
    left: -10px;
    top: -10px;
    border-width: 2px 0 0 2px;
  }
  .br--tr {
    right: -10px;
    top: -10px;
    border-width: 2px 2px 0 0;
  }
  .br--bl {
    left: -10px;
    bottom: -10px;
    border-width: 0 0 2px 2px;
  }
  .br--br {
    right: -10px;
    bottom: -10px;
    border-width: 0 2px 2px 0;
  }

  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
    }
    .about__photo {
      order: -1;
      width: min(280px, calc(100% - 20px));
      margin-left: 10px;
    }
  }
</style>
