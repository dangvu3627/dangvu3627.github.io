---
import { profile, fov } from '../data/site';
---

<section id="top" data-sec="hero" class="hero" aria-labelledby="hero-name">
  <div class="fov" aria-hidden="true">
    <span class="fov__corner fov__corner--tl"></span>
    <span class="fov__corner fov__corner--tr"></span>
    <span class="fov__corner fov__corner--bl"></span>
    <span class="fov__corner fov__corner--br"></span>
    <div class="fov__row fov__row--top mono">{fov.top.map((t) => <span>{t}</span>)}</div>
    <div class="fov__row fov__row--bottom mono">{fov.bottom.map((t) => <span>{t}</span>)}</div>
    <span class="fov__side fov__side--left mono">{fov.left}</span>
    <span class="fov__side fov__side--right mono">{fov.right}</span>
    <div class="fov__horizon">
      <span class="fov__line"></span>
      <span class="fov__cross"><span class="fov__v"></span><span class="fov__h"></span><span class="fov__c"></span></span>
      <span class="fov__line"></span>
    </div>
  </div>

  <div class="hero__content">
    <div class="hero__id">
      <span class="hero__label mono boot" style="animation-delay: 0.5s">{fov.label}</span>
      <h1 id="hero-name" class="hero__name boot" style="animation-delay: 0.6s">{profile.name}</h1>
      <p class="hero__tagline boot" style="animation-delay: 0.7s">{profile.tagline}</p>
    </div>
    <div class="hero__actions boot" style="animation-delay: 0.85s">
      <a class="btn btn--primary" href={profile.resume}>Resume</a>
      <a class="btn" href={`mailto:${profile.email}`}>Email</a>
      <a class="btn" href={profile.github} target="_blank" rel="noopener">GitHub</a>
      <a class="btn" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 680px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px var(--gutter);
    overflow: hidden;
  }

  /* ---------- FOV frame ---------- */
  .fov {
    position: absolute;
    left: max(24px, 4vw);
    right: max(24px, 4vw);
    top: 28px;
    bottom: 28px;
    pointer-events: none;
    animation: grow 0.9s var(--ease) both;
  }
  .fov__corner {
    position: absolute;
    width: 64px;
    height: 40px;
    border: 0 solid var(--text);
  }
  .fov__corner--tl {
    left: 0;
    top: 0;
    border-width: 2px 0 0 2px;
    border-top-left-radius: 10px;
  }
  .fov__corner--tr {
    right: 0;
    top: 0;
    border-width: 2px 2px 0 0;
    border-top-right-radius: 10px;
  }
  .fov__corner--bl {
    left: 0;
    bottom: 0;
    border-width: 0 0 2px 2px;
    border-bottom-left-radius: 10px;
  }
  .fov__corner--br {
    right: 0;
    bottom: 0;
    border-width: 0 2px 2px 0;
    border-bottom-right-radius: 10px;
  }
  .fov__row,
  .fov__side {
    position: absolute;
    font-size: 13px;
    color: var(--text-2);
  }
  .fov__row {
    left: 32px;
    right: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .fov__row--top {
    top: 14px;
    justify-content: space-between;
  }
  .fov__row--bottom {
    bottom: 14px;
    justify-content: space-around;
  }
  .fov__side {
    top: 50%;
  }
  .fov__side--left {
    left: 20px;
  }
  .fov__side--right {
    right: 20px;
  }
  .fov__horizon {
    position: absolute;
    left: 16%;
    right: 16%;
    top: calc(50% + 9px);
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .fov__line {
    flex: 1;
    height: 2px;
    background: var(--text);
    opacity: 0.85;
  }
  .fov__cross {
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
  }
  .fov__v,
  .fov__h,
  .fov__c {
    position: absolute;
  }
  .fov__v {
    left: 21px;
    top: -22px;
    width: 2px;
    height: 88px;
    background: var(--text);
  }
  .fov__h {
    left: -22px;
    top: 21px;
    width: 88px;
    height: 2px;
    background: var(--text);
  }
  .fov__c {
    left: 17px;
    top: 17px;
    width: 10px;
    height: 10px;
    background: var(--accent);
  }

  /* ---------- Content ---------- */
  /* Two equal rows around a 120px gap: the gap's centre always sits on the
     horizon line (frame centre + 9px offset + 22px half crosshair = +31px). */
  .hero {
    align-items: stretch;
  }
  .hero__content {
    position: relative;
    max-width: 760px;
    display: grid;
    grid-template-rows: 1fr 1fr;
    justify-items: center;
    row-gap: 120px;
    text-align: center;
    transform: translateY(31px);
  }
  .hero__id {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
  }
  .hero__label {
    font-size: 13px;
    color: var(--text-3);
  }
  .hero__name {
    font-size: clamp(44px, 7vw, 76px);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -2px;
  }
  .hero__tagline {
    font-size: 18px;
    color: var(--text-2);
    text-wrap: balance;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-content: flex-start;
    gap: 10px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 19px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-btn);
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }
  .btn:hover {
    border-color: var(--text-3);
    background: var(--surface);
  }
  .btn--primary {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
    font-weight: 600;
  }
  .btn--primary:hover {
    background: #fff;
    border-color: #fff;
    color: var(--bg);
  }

  @media (max-width: 600px) {
    .hero {
      min-height: 560px;
    }
    .fov__side,
    .fov__row--bottom {
      display: none;
    }
    .fov__row--top {
      font-size: 12px;
      left: 20px;
      right: 20px;
      gap: 2px 12px;
    }
    .fov__row--top span:nth-child(2) {
      display: none;
    }
    .fov__horizon {
      left: 8%;
      right: 8%;
    }
    .hero__tagline {
      font-size: 16px;
    }
  }
</style>
