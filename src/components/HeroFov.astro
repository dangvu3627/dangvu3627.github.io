---
import { profile, fov, cta, meta } from '../data/site';
import { publicAssetExists } from '../lib/assets';
import { isDev } from '../lib/env';

const hasPhoto = publicAssetExists(profile.photo);
const showTodo = !profile.about && isDev;

/*
 * Boot sequence (ms from load), all CSS, plays once:
 *    0  feed flickers on, FOV frame expands (700)
 *  260  telemetry readouts flicker in, 60ms apart
 *  380  crosshair focuses; 480 horizon draws outward from it (450)
 *  950  portrait resolves; 1000 target brackets lock onto it (380)
 * 1000  reticle fades away (250), clear before text arrives; 1300 "TARGET ACQUIRED" tag
 * 1100+ name, line, buttons, about content enter 80ms apart (500 each) -> done ~1.85s
 */
const t = (ms: number) => `--d: ${ms}ms`;
const tele = (i: number) => `--i: ${i}`;
const bottomStart = fov.top.length + 2;
---

<section id="top" data-sec="hero" class="hero" aria-labelledby="hero-name">
  <div class="fov" aria-hidden="true">
    <span class="fov__corner fov__corner--tl"></span>
    <span class="fov__corner fov__corner--tr"></span>
    <span class="fov__corner fov__corner--bl"></span>
    <span class="fov__corner fov__corner--br"></span>
    <div class="fov__row fov__row--top mono">
      {fov.top.map((v, i) => (
        <span class:list={['tele', { rec: i === 0 }]} style={tele(i)}>
          {v}
        </span>
      ))}
    </div>
    <div class="fov__row fov__row--bottom mono">
      {fov.bottom.map((v, i) => (
        <span class="tele" style={tele(bottomStart + i)}>
          {v}
        </span>
      ))}
    </div>
    <span class="fov__side fov__side--left mono tele" style={tele(fov.top.length)}>
      {fov.left}
    </span>
    <span class="fov__side fov__side--right mono tele" style={tele(fov.top.length + 1)}>
      {fov.right}
    </span>
    <div class="fov__reticle">
      <span class="fov__line fov__line--l"></span>
      <span class="fov__cross">
        <span class="fov__v"></span>
        <span class="fov__h"></span>
        <span class="fov__c"></span>
      </span>
      <span class="fov__line fov__line--r"></span>
    </div>
  </div>

  <div class="hero__grid">
    <div class="hero__text">
      <h1 id="hero-name" class="hero__name enter" style={t(1100)}>
        {profile.name}
      </h1>
      <p class="hero__tagline enter" style={t(1180)}>
        {profile.tagline}
      </p>
      <div class="hero__actions enter" style={t(1260)}>
        <div class="hero__row">
          <a class="btn btn--primary" href={profile.resume}>
            {cta.resume}
          </a>
          <a class="btn" href={profile.github} target="_blank" rel="noopener">
            {cta.github}
          </a>
          <a class="btn" href={profile.linkedin} target="_blank" rel="noopener">
            {cta.linkedin}
          </a>
        </div>
        <a class="btn" href={`mailto:${profile.email}`}>
          {cta.contact}
        </a>
      </div>
      <div class="hero__about enter" style={t(1340)}>
        {profile.about && <p class="hero__bio">{profile.about}</p>}
        {showTodo && <p class="hero__bio hero__todo">{meta.aboutTodo}</p>}
        <ul class="hero__meta mono">
          <li>{profile.education}</li>
          <li>{profile.award}</li>
        </ul>
      </div>
    </div>

    <div class="hero__target">
      <div class="hero__photo">
        {hasPhoto ? (
          <img
            src={profile.photo}
            alt={meta.portraitAlt}
            width="560"
            height="700"
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <div class="hero__placeholder" role="img" aria-label={meta.portraitAlt}>
            {meta.photoPlaceholder}
          </div>
        )}
      </div>
      <span class="lock lock--tl" aria-hidden="true"></span>
      <span class="lock lock--tr" aria-hidden="true"></span>
      <span class="lock lock--bl" aria-hidden="true"></span>
      <span class="lock lock--br" aria-hidden="true"></span>
      <span class="hero__tag mono" aria-hidden="true">
        {fov.label}
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: max(680px, calc(100svh - 57px));
    display: grid;
    place-items: center;
    padding: 96px max(56px, 7vw) 92px;
    overflow: hidden;
  }

  /* ---------- FOV frame ---------- */
  .fov {
    position: absolute;
    left: max(24px, 4vw);
    right: max(24px, 4vw);
    top: 28px;
    bottom: 28px;
    pointer-events: none;
  }
  .fov__corner {
    position: absolute;
    width: 64px;
    height: 40px;
    border: 0 solid var(--text);
  }
  .fov__corner--tl {
    left: 0;
    top: 0;
    border-width: 2px 0 0 2px;
    border-top-left-radius: 10px;
  }
  .fov__corner--tr {
    right: 0;
    top: 0;
    border-width: 2px 2px 0 0;
    border-top-right-radius: 10px;
  }
  .fov__corner--bl {
    left: 0;
    bottom: 0;
    border-width: 0 0 2px 2px;
    border-bottom-left-radius: 10px;
  }
  .fov__corner--br {
    right: 0;
    bottom: 0;
    border-width: 0 2px 2px 0;
    border-bottom-right-radius: 10px;
  }
  .fov__row,
  .fov__side {
    position: absolute;
    font-size: 13px;
    color: var(--text-2);
  }
  .fov__row {
    left: 32px;
    right: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .fov__row--top {
    top: 14px;
    justify-content: space-between;
  }
  .fov__row--bottom {
    bottom: 14px;
    justify-content: space-around;
  }
  .fov__side {
    top: 50%;
  }
  .fov__side--left {
    left: 20px;
  }
  .fov__side--right {
    right: 20px;
  }
  .rec::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 1px;
    animation: blink 1.2s steps(1) infinite;
  }

  /* Horizon + crosshair: only shown while booting. Its resting state is hidden,
     so with motion off it never sits across the content. */
  .fov__reticle {
    position: absolute;
    left: 16%;
    right: 16%;
    top: 50%;
    translate: 0 -50%;
    display: flex;
    align-items: center;
    gap: 24px;
    opacity: 0;
  }
  .fov__line {
    flex: 1;
    height: 2px;
    background: var(--text);
    opacity: 0.85;
  }
  .fov__line--l {
    transform-origin: right center;
  }
  .fov__line--r {
    transform-origin: left center;
  }
  .fov__cross {
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
  }
  .fov__v,
  .fov__h,
  .fov__c {
    position: absolute;
  }
  .fov__v {
    left: 21px;
    top: -22px;
    width: 2px;
    height: 88px;
    background: var(--text);
  }
  .fov__h {
    left: -22px;
    top: 21px;
    width: 88px;
    height: 2px;
    background: var(--text);
  }
  .fov__c {
    left: 17px;
    top: 17px;
    width: 10px;
    height: 10px;
    background: var(--accent);
  }

  /* ---------- Content ---------- */
  .hero__grid {
    position: relative;
    width: 100%;
    max-width: 980px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    align-items: center;
    gap: 48px 88px;
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .hero__name {
    font-size: clamp(44px, 7vw, 76px);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -2px;
  }
  .hero__tagline {
    margin-top: 16px;
    max-width: 34em;
    font-size: 18px;
    color: var(--text-2);
    text-wrap: balance;
  }
  .hero__actions {
    display: inline-grid;
    gap: 10px;
    margin-top: 32px;
  }
  .hero__row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hero__about {
    align-self: stretch;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .hero__bio {
    max-width: 62ch;
    color: var(--text-2);
  }
  .hero__bio + .hero__meta {
    margin-top: 16px;
  }
  .hero__todo {
    border: 1px dashed var(--line-strong);
    padding: 12px 14px;
    border-radius: var(--radius-chip);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    color: var(--text-3);
  }
  .hero__meta li {
    text-wrap: balance;
  }

  /* Portrait: the "target" */
  .hero__target {
    position: relative;
    width: 280px;
    aspect-ratio: 4 / 5;
    margin-bottom: 30px; /* room for the tag */
  }
  .hero__photo,
  .hero__photo img,
  .hero__placeholder {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-chip);
  }
  .hero__photo img {
    object-fit: cover;
    outline: 1px solid var(--image-outline);
    outline-offset: -1px;
  }
  .hero__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-2);
    border: 1px solid var(--line-card);
    color: var(--text-3);
    font-size: 14px;
  }
  .lock {
    position: absolute;
    width: 24px;
    height: 24px;
    border: 0 solid var(--accent);
  }
  .lock--tl {
    left: -10px;
    top: -10px;
    border-width: 2px 0 0 2px;
    --lx: -36px;
    --ly: -36px;
  }
  .lock--tr {
    right: -10px;
    top: -10px;
    border-width: 2px 2px 0 0;
    --lx: 36px;
    --ly: -36px;
  }
  .lock--bl {
    left: -10px;
    bottom: -10px;
    border-width: 0 0 2px 2px;
    --lx: -36px;
    --ly: 36px;
  }
  .lock--br {
    right: -10px;
    bottom: -10px;
    border-width: 0 2px 2px 0;
    --lx: 36px;
    --ly: 36px;
  }
  .hero__tag {
    position: absolute;
    left: -10px;
    top: calc(100% + 18px);
    font-size: 12px;
    color: var(--accent);
    white-space: nowrap;
  }

  /* ---------- Buttons ---------- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 19px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-btn);
    font-weight: 500;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-color var(--dur-hover) ease,
      background-color var(--dur-hover) ease,
      scale var(--dur-press) var(--ease-out);
  }
  .btn--primary {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
    font-weight: 600;
  }
  @media (hover: hover) {
    .btn:hover {
      border-color: var(--text-3);
      background: var(--surface);
    }
    .btn--primary:hover {
      border-color: #fff;
      background: #fff;
      color: var(--bg);
    }
  }
  .btn:active {
    scale: 0.96;
  }

  /* ---------- Boot sequence ---------- */
  .fov {
    animation: fov-on 700ms var(--ease) both;
  }
  .tele {
    animation: tele-on 360ms steps(1, end) both;
    animation-delay: calc(260ms + var(--i) * 60ms);
  }
  .fov__reticle {
    animation: reticle 1250ms linear both;
  }
  .fov__cross {
    animation: cross-on 260ms var(--ease-out) 380ms both;
  }
  .fov__line {
    animation: line-draw 450ms var(--ease-out) 480ms both;
  }
  .hero__photo {
    animation: resolve 450ms var(--ease) 950ms both;
  }
  .lock {
    animation: lock-on 380ms var(--ease-out) 1000ms both;
  }
  .hero__tag {
    animation: tele-on 360ms steps(1, end) 1300ms both;
  }
  .enter {
    animation: enter 500ms var(--ease) both;
    animation-delay: var(--d);
  }

  /* Feed connecting: a short signal flicker while the frame opens out */
  @keyframes fov-on {
    0% {
      opacity: 0;
      transform: scale(0.6);
    }
    12% {
      opacity: 0.85;
    }
    20% {
      opacity: 0.2;
    }
    32% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes tele-on {
    0% {
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
    70%,
    100% {
      opacity: 1;
    }
  }
  /* Visible from the start, held until the lock (1000ms), gone by 1250ms */
  @keyframes reticle {
    0%,
    80% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes cross-on {
    from {
      opacity: 0;
      transform: scale(1.4);
    }
  }
  @keyframes line-draw {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes resolve {
    from {
      opacity: 0;
      filter: blur(6px);
    }
  }
  @keyframes lock-on {
    from {
      opacity: 0;
      transform: translate(var(--lx), var(--ly));
    }
  }
  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(12px);
      filter: blur(4px);
    }
  }

  /* ---------- Responsive ---------- */
  /* Side readouts need clear space beside the content column */
  @media (max-width: 1360px) {
    .fov__side {
      display: none;
    }
  }
  @media (max-width: 860px) {
    .hero {
      padding-top: 84px;
    }
    .hero__grid {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 36px;
    }
    .hero__text {
      align-items: center;
    }
    .hero__row {
      justify-content: center;
    }
    .hero__meta {
      justify-content: center;
    }
    .hero__bio {
      margin-inline: auto;
    }
    .hero__target {
      order: -1;
      width: 168px;
    }
    .hero__tag {
      left: 50%;
      translate: -50% 0;
    }
  }
  @media (max-width: 600px) {
    .hero {
      min-height: 560px;
      padding: 100px 40px 64px;
    }
    .fov__row--bottom {
      display: none;
    }
    .fov__row--top {
      font-size: 12px;
      left: 20px;
      right: 20px;
      gap: 2px 12px;
    }
    .fov__row--top span:nth-child(2) {
      display: none;
    }
    .fov__reticle {
      left: 8%;
      right: 8%;
    }
    .hero__target {
      width: 136px;
    }
    .hero__tagline {
      font-size: 16px;
    }
    .btn {
      padding: 0 16px;
    }
  }
</style>
