---
import { profile, sections, hudMap } from '../data/site';
const start = hudMap.hero!;
---

<header class="hud mono">
  <div class="hud__inner">
    <a href="#top" class="hud__brand">
      <span class="hud__dot blink" aria-hidden="true"></span>
      <span class="hud__name">{profile.name}</span>
    </a>
    <nav class="hud__nav" aria-label="Sections">
      <div class="hud__track" data-nav-track>
        {sections.map((s) => (
          <a href={`#${s.id}`} data-nav={s.sec}>
            {s.label}
          </a>
        ))}
        <!-- Active pill: a copy of the list in the active style, clipped to the active link. -->
        <div class="hud__pill" data-nav-pill aria-hidden="true">
          {sections.map((s) => (
            <span>{s.label}</span>
          ))}
        </div>
      </div>
    </nav>
    <div class="hud__readout" aria-hidden="true">
      <span>
        SEC:{' '}
        <span class="hud__val" data-hud-sec>
          {start.label}
        </span>
      </span>
      <span>
        ALT:{' '}
        <span class="hud__val" data-hud-alt>
          {start.alt}m
        </span>
      </span>
    </div>
  </div>
</header>

<style>
  .hud {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(10, 11, 12, 0.82);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    font-size: 13px;
  }
  .hud__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 6px var(--gutter);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0 24px;
  }
  .hud__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    text-decoration: none;
  }
  .hud__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .hud__name {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 15px;
  }
  .hud__nav {
    display: flex;
    justify-content: center;
  }
  .hud__track {
    position: relative;
    display: flex;
    gap: 4px;
  }
  .hud__track a,
  .hud__pill span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    white-space: nowrap;
  }
  .hud__track a {
    border-radius: 6px;
    color: var(--text-2);
    text-decoration: none;
    transition: color var(--dur-hover) ease;
  }
  @media (hover: hover) {
    .hud__track a:hover {
      color: var(--text);
    }
  }
  .hud__pill {
    position: absolute;
    inset: 0;
    display: flex;
    gap: 4px;
    pointer-events: none;
    /* Collapsed until hud.ts measures the active link */
    clip-path: inset(4px 100% 4px 0 round 6px);
  }
  .hud__pill span {
    background: var(--text);
    color: var(--bg);
  }
  /* Set by hud.ts after the first measurement, so the pill never animates in on load */
  .hud__pill[data-ready] {
    transition: clip-path var(--dur-pill) var(--ease-in-out);
  }
  .hud__readout {
    display: flex;
    gap: 18px;
    color: var(--text-3);
    white-space: nowrap;
  }
  .hud__val {
    color: var(--text);
  }

  @media (max-width: 860px) {
    .hud__inner {
      grid-template-columns: 1fr auto;
    }
    .hud__nav {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: flex-start;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      margin: 0 calc(var(--gutter) * -1);
      padding: 0 var(--gutter) 4px;
    }
    .hud__nav::-webkit-scrollbar {
      display: none;
    }
  }
</style>
